Package: lookout
Type: Package
Title: Leave One Out Kernel Density Estimates for Outlier Detection
Version: 2.0.2.9000
Authors@R: c(
  person("Sevvandi", "Kandanaarachchi", email = "sevvandik@gmail.com",
  role = c("aut", "cre"), comment = c(ORCID = "0000-0002-0337-0395")),
